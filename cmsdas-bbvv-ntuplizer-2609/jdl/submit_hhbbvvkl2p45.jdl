Universe = vanilla
Executable = run.sh
EOSDIR = root://eoscms.cern.ch//store/cmst3/group/vhcc/sfTuples/trees_sf/20260927_NanoV15_standalone_cmsdas_bbvv_ntuples
Arguments = $(input_file) $(EOSDIR)/ntuple_hhbbvvkl2p45_$(Cluster)_$(Process).root
request_cpus = 1
request_memory = 2000
use_x509userproxy = true
+JobFlavour = "tomorrow"
Log = log/job.log_$(Cluster)
Output = log/job.out_$(Cluster)-$(Process)
Error = log/job.err_$(Cluster)-$(Process)
should_transfer_files = YES
when_to_transfer_output = ON_SUCCESS
success_exit_code = 0
transfer_input_files = nanoAOD_to_cmsdas_bbvv.C
transfer_output_files = dummy.cc
Queue input_file from samples/hhbbvvkl2p45.txt
