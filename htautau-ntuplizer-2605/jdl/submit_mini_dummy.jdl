Universe   = vanilla
Executable = run_from_mini.sh

# custom args
EOSDIR = root://eoscms.cern.ch//store/cmst3/group/vhcc/sfTuples/trees_sf/20260612_MiniToNanoV15_custom_tagger_htautau_ntuples
MAX_EVENTS = -1

Arguments = $(input_file) $(EOSDIR)/ntuple_fatjet_$(output_file).root $(MAX_EVENTS)

request_cpus = 8
request_memory = 8000
use_x509userproxy = true

+JobFlavour = "tomorrow"

Log        = log/job.log_$(Cluster)
Output     = log/job.out_$(Cluster)-$(Process)
Error      = log/job.err_$(Cluster)-$(Process)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_input_files    = run_from_mini.sh,nanoAOD_to_htautau_fatjet_custom_tagger.C,HTauTauNtuplizerUtils.h,NanoTuples_nanov15_custom.tgz
transfer_output_files   = dummy.cc

Queue input_file, output_file from samples/mini_dummy.txt
