Universe   = vanilla
Executable = run.sh

# custom args
EOSDIR = root://eoscms.cern.ch//store/cmst3/group/vhcc/sfTuples/trees_sf/20260530_NanoV15_standalone_htautau_ntuples

Arguments = $(input_file) $(EOSDIR)/ntuple_fatjet_$(output_file).root $(EOSDIR)/ntuple_boostedtau_$(output_file).root

request_cpus = 1
request_memory = 2000
use_x509userproxy = true

+JobFlavour = "tomorrow"

Log        = log/job.log_$(Cluster)
Output     = log/job.out_$(Cluster)-$(Process)
Error      = log/job.err_$(Cluster)-$(Process)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_input_files    = nanoAOD_to_htautau_fatjet.C,nanoAOD_to_htautau_boostedTau.C,HTauTauNtuplizerUtils.h
transfer_output_files   = dummy.cc

Queue input_file, output_file from samples/bkg_qcd170to300.txt
